# Copy to .env and fill in. Never commit .env -- it is gitignored.

# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# ---- Supabase ----
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable (client-safe) key -- used for password sign-in.
SUPABASE_PUBLISHABLE_KEY=

# Secret key -- server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# ---- Auth policy ----
# Minutes of inactivity before a session is considered stale.
SESSION_TIMEOUT_MINUTES=30

# Failed attempts before the account is temporarily locked.
MAX_FAILED_LOGIN_ATTEMPTS=5

# How long the lock lasts, in minutes.
ACCOUNT_LOCK_MINUTES=15

# Where Supabase sends the user after clicking the password-reset email.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
