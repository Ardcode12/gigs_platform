# ==========================================
# GigMat Society Backend — Environment Config
# Copy this to .env and fill in your values
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gigmat_society
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Secret — change this to a long random string in production
JWT_SECRET=gigmat_sih2026_super_secret_key_change_in_prod
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
