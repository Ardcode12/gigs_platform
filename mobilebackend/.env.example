# ---- Database (Supabase Postgres) ----------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection / session pooler (port 5432) for both the app and Alembic.
# Note the driver prefix: postgresql+psycopg:// (psycopg 3), not postgresql://
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ---- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Society / admin API -------------------------------------------------
# Required in the X-Admin-Key header to create workers or force-reset passwords.
ADMIN_API_KEY=change-me-too

# ---- Dev behaviour -------------------------------------------------------
# true  -> /api/dev/* test-harness routes are mounted.
# false -> the dev harness is not mounted. OTP values are never returned in the API.
DEV_MODE=false

# ---- Twilio Verify V2 OTP -------------------------------------------------
# Keep real credentials only in the local backend .env, never in the frontend.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- CORS ----------------------------------------------------------------
# Comma-separated. "*" is fine for local Expo development.
CORS_ORIGINS=*

# ---- Geo -----------------------------------------------------------------
# Average city travel speed (km/h) used to turn distance into an ETA.
AVG_SPEED_KMPH=22

# ---- Locale --------------------------------------------------------------
# Decides where the day boundary falls for the daily/weekly/monthly earnings
# breakdown. Timestamps are always stored in UTC.
TIMEZONE=Asia/Kolkata

# ---- Chat translation -----------------------------------------------------
# none  -> messages are stored and served exactly as written; nothing translates.
# local -> use the IndicTrans2 sidecar; see mobilebackend/translator/README.md.
# Either way chat keeps working: if the sidecar is down or slow, reads fall back
# to the original text rather than failing.
TRANSLATION_PROVIDER=none
LOCAL_TRANSLATE_URL=http://127.0.0.1:8001/translate
LOCAL_TRANSLATE_TIMEOUT_SECONDS=30
